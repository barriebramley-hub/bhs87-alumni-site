---
interface Props { current?: 'home' | 'blog' | 'about' | 'contact'; hero?: boolean }
const { current, hero = false } = Astro.props;
const items = [
  ['Home', '/', 'home'],
  ['Blog', '/blog', 'blog'],
  ['About', '/about', 'about'],
  ['Contact', '/contact', 'contact'],
] as const;
---
<header class="bb-head">
  <div class="bb-head-in">
    <a class="bb-brand" href="/">
      <img class:list={['bb-brand-logo', { 'bb-brand-logo--phone-only': hero }]} src="/images/logo-160.webp" alt="Bryanston High School alumni crest" width="56" height="56" />
      <span style="display:flex;flex-direction:column;gap:4px">
        <span>BHS Class of '87</span>
        <span class="bb-brand-sub">Bryanston High School Alumni</span>
      </span>
    </a>
    <nav class="bb-nav">
      {items.map(([label, href, key]) => <a href={href} class:list={[{ 'is-current': key === current }]} aria-current={key === current ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
  <slot name="hero" />
</header>
