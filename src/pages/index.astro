---
import Base from '../layouts/Base.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import NuggetRow from '../components/NuggetRow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Chip from '../components/Chip.astro';
import Cta from '../components/Cta.astro';
import { getPosts, CATEGORIES, catSlug, countFor } from '../lib/posts';

const posts = await getPosts();
const [featured, ...rest] = posts;
const recent = rest.slice(0, 3);
const podcasts = posts.filter((p) => p.category === 'Podcasts' && p.podcastUrl).slice(0, 4);
---
<Base current="home" hero>
  <div class="bb-hero bb-wrap" slot="hero">
    <div>
      <div class="bb-kicker">Est. 1987 · Still going</div>
      <h1 class="bb-h1">The Class of 1987. Older, if not wiser.</h1>
      <p class="bb-hero-lead">This is the home of the Bryanston High School Class of 1987. We're still building it out, but you'll find articles from fellow alumni, links to podcasts, news of future happenings and events, and details about the Class of 1987 Foundation NPC.</p>
    </div>
    <img class="bb-hero-logo" src="/images/logo-480.webp" alt="Bryanston High School alumni crest" width="480" height="480" fetchpriority="high" decoding="async" />
  </div>

  <main>
    {featured && (
      <div class="bb-wrap bb-home-first">
        <FeaturedPost href={featured.href} image={featured.hero} title={featured.title} excerpt={featured.excerpt} date={featured.date} category={featured.category} />
        {recent.length > 0 && (
          <div class="bb-rule" style="margin-top:52px;padding-top:40px">
            <SectionHeading>More recent posts</SectionHeading>
            <div class="bb-cards">
              {recent.map((p) => <PostCard href={p.href} image={p.hero} title={p.title} excerpt={p.excerpt} meta={p.meta} category={p.category} />)}
            </div>
          </div>
        )}
        <div style="margin-top:36px"><Cta href="/blog">All {posts.length} posts</Cta></div>
      </div>
    )}

    {podcasts.length > 0 && (
      <section class="bb-podcast">
        <div class="bb-wrap bb-podcast-in">
          <div>
            <SectionHeading>Podcasts</SectionHeading>
            <p class="bb-podcast-copy">Classmates talking into microphones for longer than any teacher would have allowed. Episodes open on the host's site.</p>
          </div>
          <div class="bb-podcast-list">
            {podcasts.map((p) => <NuggetRow href={p.podcastUrl} image={p.hero} title={p.title} summary={p.excerpt} host={p.podcastHost ?? 'Podcast host'} />)}
          </div>
        </div>
      </section>
    )}

    <section class="bb-alt" style={podcasts.length === 0 ? 'margin-top:52px' : undefined}>
      <div class="bb-wrap">
        <SectionHeading>Browse by subject</SectionHeading>
        <div class="bb-chips">
          {CATEGORIES.map((c) => <Chip href={`/blog/${catSlug(c)}`} count={countFor(posts, c)}>{c}</Chip>)}
        </div>
      </div>
    </section>
  </main>
</Base>
