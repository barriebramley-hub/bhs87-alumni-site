---
const { href, image, title, summary, host } = Astro.props;
---
<a class="bb-nug" href={href} target="_blank" rel="noopener">
  <div class="bb-nug-thumb">
    {image && <img src={image} alt="" loading="lazy" />}
  </div>
  <div>
    <h3 class="bb-nug-title">{title}</h3>
    <p class="bb-nug-summary">{summary}</p>
    <div class="bb-nug-host">{host} ↗</div>
  </div>
</a>
