---
const { href, image, title, summary, host } = Astro.props;
---
<a class="bb-nug" href={href} target="_blank" rel="noopener" style="display:grid;grid-template-columns:clamp(84px,20cqw,120px) minmax(0,1fr);gap:clamp(14px,3cqw,22px);align-items:start;padding:22px 0;border-bottom:var(--bb-rule-hair)">
  <div style={`background:${image ? 'var(--bb-image-bed)' : 'var(--bb-hatch)'};border:${image ? 'none' : '1px solid var(--bb-grey)'};overflow:hidden;aspect-ratio:16 / 10`}>
    {image && <img src={image} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />}
  </div>
  <div>
    <h3 style="font-family:var(--bb-font-display);font-weight:800;font-size:18px;line-height:1.25;margin:0;text-wrap:pretty">{title}</h3>
    <p style="font-size:14px;line-height:1.6;color:var(--bb-text-muted);margin:7px 0 0">{summary}</p>
    <div style="font-family:var(--bb-font-display);font-weight:700;font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--bb-text-muted);margin-top:8px">{host} ↗</div>
  </div>
</a>
