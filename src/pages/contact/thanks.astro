---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
---
<Base title="Received" current="contact">
  <main class="bb-wrap">
    <section style="padding:56px 0 44px">
      <div class="bb-kicker" style="margin-bottom:18px">Contact</div>
      <div style="padding:10px 0 40px;border-bottom:1px solid var(--bb-border)">
        <h1 style="font-weight:700;font-size:clamp(22px,3cqw,30px);line-height:1.1;margin:0">Received. Thank you.</h1>
        <p style="font-size:16px;line-height:1.65;color:var(--bb-text-muted);margin:12px 0 0;max-width:48ch">Barrie will reply when he's back from wherever he is. In the meantime, go and read something.</p>
        <div style="margin-top:20px"><Cta href="/blog">To the blog</Cta></div>
      </div>
    </section>
  </main>
</Base>
