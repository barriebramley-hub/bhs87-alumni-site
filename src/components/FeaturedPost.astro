---
import ImageBlock from './ImageBlock.astro';
import Label from './Label.astro';
const { href, image, title, excerpt, date, category, cta = 'Read this one' } = Astro.props;
---
<a class="bb-feature" href={href} style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(20px,3cqw,36px);align-items:start">
  <ImageBlock src={image} alt={title} ratio="16 / 10" fallbackLabel={category} />
  <div>
    <div style="display:flex;gap:14px;align-items:center">
      <Label>{date}</Label>
      <span style="width:18px;height:1px;background:var(--bb-link);display:block"></span>
      <Label>{category}</Label>
    </div>
    <h2 class="bb-feature-title">{title}</h2>
    <p class="bb-feature-lead">{excerpt}</p>
    <span class="bb-cta">{cta}</span>
  </div>
</a>
