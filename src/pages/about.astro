---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SplitSection from '../components/SplitSection.astro';

const about = await getEntry('pages', 'about');
const sections = about?.data.sections ?? [];
---
<Base title="About" current="about">
  <main class="bb-wrap">
    <section style="padding:56px 0 44px">
      <div class="bb-kicker" style="margin-bottom:18px">About</div>
      <h1 class="bb-h1" style="max-width:18ch;text-wrap:pretty">A few hundred people who left school in the same year.</h1>
      <p style="margin:18px 0 0;font-size:17px;line-height:1.7;color:var(--bb-text-muted);max-width:52ch">Four headings below. They cover most of it.</p>
    </section>
    {sections.map((s) => (
      <SplitSection number={s.number} title={s.title}>
        <p style="margin:0;font-size:17px;line-height:1.75;max-width:62ch">{s.body}</p>
      </SplitSection>
    ))}
  </main>
</Base>
