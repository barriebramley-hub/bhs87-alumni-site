---
const { prev, next } = Astro.props;
---
<div class="bb-postnav">
  <a href={prev.href}><div class="bb-postnav-label">← Previous</div><div class="bb-postnav-title">{prev.title}</div></a>
  <a href={next.href}><div class="bb-postnav-label">Next →</div><div class="bb-postnav-title">{next.title}</div></a>
</div>
