---
interface Props { current?: 'home' | 'blog' | 'about' | 'contact' }
const { current } = Astro.props;
const items = [
  ['Home', '/', 'home'],
  ['Blog', '/blog', 'blog'],
  ['About', '/about', 'about'],
  ['Contact', '/contact', 'contact'],
] as const;
---
<header class="bb-head">
  <div class="bb-head-in">
    <a class="bb-brand" href="/">
      <img src="/images/bhs-logo.png" alt="Bryanston High School alumni crest" width="64" height="64" style="width:64px;height:64px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:4px">
        <span>BHS Class of '87</span>
        <span style="font-weight:700;font-size:10px;letter-spacing:0.18em;color:#666666">Bryanston High School Alumni</span>
      </span>
    </a>
    <nav class="bb-nav">
      {items.map(([label, href, key]) => <a href={href} class:list={[{ 'is-current': key === current }]}>{label}</a>)}
    </nav>
  </div>
</header>
